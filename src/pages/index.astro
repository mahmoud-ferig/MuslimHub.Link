---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard";

const description =
  "MuslimHub is a central directory for open-source Islamic applications, developer resources, and tools for the Ummah.";

const projects = [
  {
    title: "Quran.com API",
    description: "A robust API powering Quranic content and services for developers.",
    href: "https://github.com/quran/quran.com-api"
  },
  {
    title: "Aladhan",
    description: "Prayer times API with global coverage and useful Islamic date tools.",
    href: "https://github.com/islamic-network/api.aladhan.com"
  },
  {
    title: "Islamic Network",
    description: "Open APIs and datasets for Quran, hadith, prayer times, and more.",
    href: "https://github.com/islamic-network"
  }
];
---

<Layout title="MuslimHub | Open-Source Islamic Project Directory" description={description} canonicalUrl="https://muslimhub.link/">
  <section class="rounded-2xl border border-emerald-100 bg-white p-8 shadow-sm">
    <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">MuslimHub</h1>
    <p class="mt-4 max-w-3xl text-base leading-7 text-gray-700 sm:text-lg">
      MuslimHub is a central directory for open-source Islamic applications, developer resources, and tools for the Ummah.
    </p>
  </section>

  <section class="mt-10">
    <h2 class="text-2xl font-semibold text-gray-900">Featured App</h2>
    <article class="mt-4 rounded-2xl border-2 border-emerald-300 bg-emerald-100/60 p-6 shadow-sm">
      <h3 class="text-xl font-semibold text-gray-900">Quran Audio Tracker</h3>
      <p class="mt-2 text-gray-700">
        A Progressive Web App to track and manage your daily Quran listening and memorization.
      </p>
      <a
        href="https://github.com/mahmoud-ferig/Quran-Audio-Tracker-PWA-"
        target="_blank"
        rel="noreferrer"
        aria-label="Open Quran Audio Tracker on GitHub"
        class="mt-4 inline-flex rounded-md bg-emerald-700 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-800"
      >
        View on GitHub
      </a>
    </article>
  </section>

  <section class="mt-10">
    <h2 class="text-2xl font-semibold text-gray-900">Community Open Source Projects</h2>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>
  </section>
</Layout>
